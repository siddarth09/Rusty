        <update_rate>5</update_rate>
        <topic>scan</topic>
        <gz_frame_id>lidar_1</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1.000000</resolution>
