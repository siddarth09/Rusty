      <parent>base_link</parent>
      <child>holder_1</child>
      <axis/>
    </joint>

    <joint name="lidar" type="fixed">
      <pose relative_to="base_link">0.235 0.0 0.135 0.0 -0.0 0.0</pose>
      <parent>base_link</parent>
      <child>lidar_1</child>
      <axis/>
    </joint>

    
    <joint name="camera" type="fixed">
      <pose relative_to="base_link">0.23758847904659944 0.08709913265558741 0.125 0.0 -0.0 0.0</pose>
      <parent>base_link</parent>
      <child>camera_1</child>
      <axis/>
    </joint>
    

    <plugin
       filename="ignition-gazebo-diff-drive-system"
      name="ignition::gazebo::systems::DiffDrive">
      <left_joint>lw1</left_joint>
     <left_joint>lw2</left_joint>
     <right_joint>rw1</right_joint>
     <right_joint>rw2</right_joint>
     <wheel_separation>1.25</wheel_separation>
     <wheel_radius>0.3</wheel_radius>
     <odom_publish_frequency>1</odom_publish_frequency>
     <max_linear_acceleration>1</max_linear_acceleration>
     <min_linear_acceleration>-1</min_linear_acceleration>
     <max_angular_acceleration>2</max_angular_acceleration>
     <min_angular_acceleration>-2</min_angular_acceleration>
     <max_linear_velocity>0.5</max_linear_velocity>
     <min_linear_velocity>-0.5</min_linear_velocity>
     <max_angular_velocity>1</max_angular_velocity>
     <topic>cmd_vel</topic>
     <odom_topic>odom</odom_topic>
     <frame_id>odom</frame_id>
     <tf_topic>/tf</tf_topic>
     <odom_publisher_frequency>30</odom_publisher_frequency>
     <child_frame_id>base_link</child_frame_id>

     <!-- <topic>/cmd_vel</topic>
     <odom_topic>/odom</odom_topic>
     <tf_topic>/tf</tf> -->
                
    </plugin>
    
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <!-- <update_rate>30</update_rate> -->
      <joint_name>lw1</joint_name>
      <joint_name>lw2</joint_name>
      <joint_name>rw1</joint_name>
      <joint_name>rw2</joint_name>
    </plugin>     

  </model>
</sdf>
