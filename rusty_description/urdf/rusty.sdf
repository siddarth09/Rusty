      </axis>
    </joint>


    <joint name="lw2" type="continuous">
      <pose relative_to="base_link">-0.095 0.16 0.05000000000000002 0.0 -0.0 0.0</pose>
      <parent>base_link</parent>
      <child>lw2_1</child>
      <axis>
        <xyz expressed_in="base_link">0.0 -1.0 0.0</xyz>
      </axis>
    </joint>


    <joint name="lw1" type="continuous">
      <pose relative_to="base_link">0.09500000000000001 0.16 0.05000000000000002 0.0 -0.0 0.0</pose>
      <parent>base_link</parent>
      <child>lw1_1</child>
      <axis>
        <xyz expressed_in="base_link">0.0 1.0 0.0</xyz>
