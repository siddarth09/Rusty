   <!--JOINTS-->


    <joint name="rw2" type="continuous">
      <pose relative_to="base_link">-0.095 -0.16 0.05 0.0 -0.0 0.0</pose>
      <parent>base_link</parent>
      <child>rw2_1</child>
      <axis>
        <xyz expressed_in="base_link">0.0 -1.0 0.0</xyz>
      </axis>
    </joint>

    <joint name="rw1" type="continuous">
      <pose relative_to="base_link">0.095 -0.16 0.05 0.0 -0.0 0.0</pose>
      <parent>base_link</parent>
      <child>rw1_1</child>
      <axis>
